{
  "$schema": "https://opencode.ai/config.json",
  "disabled_providers": ["opencode"],
  "model": "openai/gpt-5.4",
  "small_model": "openai/gpt-5.4-mini",
  "subagent_depth": 0,
  "default_agent": "plan",
  "permission": {
    "*": "allow",
    "bash": {
      "*": "allow",
      "rm *": "ask"
    },
    "webfetch": "ask",
    "websearch": "ask",
    "external_directory": "ask"
  }
}
