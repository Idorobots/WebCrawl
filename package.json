{
  "name": "webcrawl",
  "version": "1.0.0",
  "private": true,
  "description": "Explore remote HTML DOM trees as a dungeon crawler.",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n server,client \"tsx watch src/server/index.ts\" \"vite\"",
    "build": "vite build && tsc -p tsconfig.server.json",
    "start": "node dist/server/index.js",
    "typecheck": "tsc -p tsconfig.client.json && tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.tests.json",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "d3": "^7.9.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/d3": "^7.4.3",
    "@types/node": "^22.20.1",
    "concurrently": "^9.2.1",
    "jsdom": "^29.1.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  }
}
